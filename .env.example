# Supabase PostgreSQL (Session pooler recommended for serverless)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Auth token signing (use a long random string in production)
JWT_SECRET=your-secret-key-here

# Razorpay — https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_, live keys with rzp_live_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Public key for checkout UI (same Key ID as above, exposed to browser)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
