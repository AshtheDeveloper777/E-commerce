# =============================================================================
# REQUIRED on Vercel (add all of these in Vercel → Settings → Environment Variables)
# =============================================================================

# Supabase PostgreSQL — Transaction pooler (port 6543) for serverless
# Supabase → Project Settings → Database → Connection string → URI (Session pooler)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Auth — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=your-secret-key-here

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# =============================================================================
# Local only — copy this file to .env and fill in real values
# =============================================================================
